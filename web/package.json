{
  "name": "guanghe-drift-bottle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:production": "CLOUDFLARE_ENV=production vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:local": "npm run cf:types && npm run typecheck && npm run cf:check && npm run audit:source && npm run smoke:local:all && npm audit --audit-level=moderate",
    "verify:launch": "npm run cf:types && npm run typecheck && npm run cf:check && npm run audit:source && npm audit --audit-level=moderate",
    "verify:production": "npm run cf:types && npm run typecheck && npm run cf:check:production && npm run audit:source && npm audit --audit-level=moderate",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "cf:check": "npm run build && wrangler deploy --dry-run --env=\"\"",
    "cf:check:production": "npm run build:production && wrangler deploy --dry-run --env production",
    "deploy": "wrangler deploy",
    "deploy:retry": "npm run build && node scripts/deploy-with-retry.mjs",
    "deploy:production:retry": "npm run build:production && node scripts/deploy-with-retry.mjs --env production",
    "audit:source": "node scripts/audit-source.mjs",
    "smoke:public": "node scripts/smoke-public.mjs",
    "smoke:public:headers": "EXPECT_SECURITY_HEADERS=true node scripts/smoke-public.mjs",
    "smoke:production:auth": "node scripts/smoke-production-auth.mjs",
    "smoke:production:admin": "node scripts/smoke-production-admin.mjs",
    "smoke:production:turnstile": "node scripts/smoke-production-turnstile.mjs",
    "smoke:public:local": "node scripts/smoke-public.mjs http://127.0.0.1:8787",
    "smoke:public:local:headers": "EXPECT_SECURITY_HEADERS=true node scripts/smoke-public.mjs http://127.0.0.1:8787",
    "smoke:queue:local": "node scripts/smoke-queue-local.mjs",
    "smoke:queue:local:auto": "node scripts/smoke-queue-local-auto.mjs",
    "smoke:local:all": "node scripts/smoke-local-all.mjs",
    "launch:readiness": "node scripts/check-launch-readiness.mjs",
    "launch:readiness:remote": "node scripts/check-launch-readiness.mjs --remote-secrets",
    "launch:readiness:remote:strict": "node scripts/check-launch-readiness.mjs --remote-secrets --strict",
    "launch:readiness:strict": "node scripts/check-launch-readiness.mjs --strict",
    "launch:gates": "node scripts/audit-launch-gates.mjs",
    "launch:gates:strict": "node scripts/audit-launch-gates.mjs --strict",
    "launch:gates:remote": "node scripts/audit-launch-gates.mjs --remote",
    "launch:gates:remote:strict": "node scripts/audit-launch-gates.mjs --remote --strict",
    "preseed:build": "node scripts/generate-preseed-sql.mjs",
    "db:migrate:local": "wrangler d1 migrations apply guanghe-drift-bottle-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply guanghe-drift-bottle-db --remote",
    "db:info:remote": "wrangler d1 info guanghe-drift-bottle-db",
    "db:bookmark:remote": "wrangler d1 time-travel info guanghe-drift-bottle-db",
    "db:export:local": "mkdir -p backups/d1 && wrangler d1 export guanghe-drift-bottle-db --local --output \"backups/d1/guanghe-drift-bottle-db-local-$(date -u +%Y%m%dT%H%M%SZ).sql\" --skip-confirmation",
    "db:export:remote": "mkdir -p backups/d1 && wrangler d1 export guanghe-drift-bottle-db --remote --output \"backups/d1/guanghe-drift-bottle-db-remote-$(date -u +%Y%m%dT%H%M%SZ).sql\" --skip-confirmation",
    "db:seed:local": "wrangler d1 execute guanghe-drift-bottle-db --local --file=./scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute guanghe-drift-bottle-db --remote --file=./scripts/seed.sql",
    "db:preseed:local": "npm run preseed:build && wrangler d1 execute guanghe-drift-bottle-db --local --file=./scripts/preseed.generated.sql",
    "db:preseed:remote": "npm run preseed:build && node scripts/execute-preseed-remote.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^2.10.3",
    "@clerk/clerk-react": "^5.34.0",
    "hono": "^4.7.11",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.9.6",
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.60.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.19.1"
  }
}
